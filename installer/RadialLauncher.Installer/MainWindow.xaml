<Window x:Class="RadialLauncher.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radial Launcher v1.0.0 — Setup Wizard"
        Height="470" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0B0E17"
        Icon="app.ico">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#121726" BorderBrush="#20293E" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="app.ico" Width="48" Height="48" Margin="0,0,18,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Radial Launcher" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#6366F1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtHeaderSub" Text="Professional Radial Application &amp; Game Launcher for Windows" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Language Selector Toggle in Setup Wizard Header -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLangEn" Content="🇬🇧 English" Padding="8,4" Margin="0,0,6,0" Background="#1E2638" Foreground="White" BorderBrush="#2E3A52" Cursor="Hand" Click="BtnLangEn_Click"/>
                    <Button x:Name="BtnLangTr" Content="🇹🇷 Türkçe" Padding="8,4" Background="#1E2638" Foreground="White" BorderBrush="#2E3A52" Cursor="Hand" Click="BtnLangTr_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20">
            <StackPanel x:Name="SetupPanel">
                <!-- Target Directory Selection -->
                <TextBlock x:Name="TxtInstallDirLabel" Text="Installation Directory:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtInstallPath" Grid.Column="0" Height="36" IsReadOnly="False"/>
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse..." Width="80" Height="36" Margin="8,0,0,0"
                            Background="#1E2638" Foreground="#F8FAFC" BorderBrush="#2E3A52" Cursor="Hand" Click="BtnBrowse_Click"/>
                </Grid>

                <!-- Options -->
                <TextBlock x:Name="TxtOptionsLabel" Text="Installation Options:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,4,0,6"/>
                <Border Background="#121726" BorderBrush="#20293E" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut" IsChecked="True"/>
                        <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu Shortcut" IsChecked="True"/>
                        <CheckBox x:Name="ChkAutoStartup" Content="Run automatically on Windows startup (Tray Mode)" IsChecked="True"/>
                        <CheckBox x:Name="ChkLaunchAfter" Content="Launch Radial Launcher when setup completes" IsChecked="True"/>
                        <CheckBox x:Name="ChkCleanInstall" Content="Clean Install (Reset existing user data &amp; shortcuts)" IsChecked="False" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Clean Guarantee Note -->
                <Border Background="#0E2A1E" BorderBrush="#1B4D36" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCleanGuarantee" Text="Clean Standalone Installation: Your settings and shortcuts will be safely stored in %LOCALAPPDATA%\RadialLauncher" 
                                   FontSize="11" Foreground="#4ADE80" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Progress Panel (Overlay / Replaces SetupPanel when installing) -->
        <Border Grid.Row="1" x:Name="ProgressPanel" Visibility="Collapsed" Background="#0B0E17" Padding="40,50">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                <TextBlock x:Name="TxtStatus" Text="Starting installation..." FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                <ProgressBar x:Name="ProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#6366F1" Background="#1E2638" BorderThickness="0"/>
                <TextBlock x:Name="TxtStatusDetail" Text="Please wait..." FontSize="12" Foreground="#94A3B8" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer / Action Buttons -->
        <Border Grid.Row="2" Background="#121726" BorderBrush="#20293E" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock x:Name="TxtFooterInfo" Text="Requirements: Windows 10/11 x64" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="34" Margin="0,0,10,0"
                            Background="#1E2638" Foreground="#94A3B8" BorderBrush="#2E3A52" Cursor="Hand" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnInstall" Content="Install Now" Width="130" Height="34"
                            Background="#6366F1" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnInstall_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
