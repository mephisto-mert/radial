<Window x:Class="RadialLauncher.UI.Windows.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radial Launcher — Ayarlar ve Yönetim Paneli" Height="650" Width="920"
        WindowStartupLocation="CenterScreen" Background="#16161A" Foreground="#EEEEEE">
    
    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2C2C36"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E4C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Tab Item Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#202028" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2B3A4C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#282834"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Main Header -->
            <RowDefinition Height="*"/>    <!-- Tab Control -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status & Close -->
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Radial Launcher — Kontrol Merkezi" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Kısayolları yönetin, kategorileri düzenleyin, akıllı PC tarayıcısını çalıştırın ve temayı kişiselleştirin." FontSize="12" Foreground="#888899" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#22222C" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="v2.1 Pro" FontSize="11" Foreground="#588CEC" FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- Main Tab Control -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: ITEMS & SHORTCUTS -->
            <TabItem Header="📋 Kısayollarım">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Action Bar -->
                    <Border Grid.Row="0" Background="#1E1E24" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="➕ Yeni Ekle" Background="#2980B9" FontWeight="SemiBold" Margin="0,0,6,0" Click="AddButton_Click"/>
                                <Button Content="✏️ Düzenle" Background="#27AE60" FontWeight="SemiBold" Margin="0,0,6,0" Click="EditButton_Click" ToolTip="Seçili öğeyi düzenle"/>
                                <Button Content="🗑️ Sil" Background="#C0392B" Margin="0,0,6,0" Click="DeleteButton_Click"/>
                                <Button Content="⭐ Favori" Margin="0,0,6,0" Click="ToggleFavorite_Click" ToolTip="İç halkada yıldızlı göster"/>
                                <Button Content="▲" Margin="0,0,2,0" Width="30" Click="MoveUp_Click" ToolTip="Yukarı Taşı"/>
                                <Button Content="▼" Margin="0,0,10,0" Width="30" Click="MoveDown_Click" ToolTip="Aşağı Taşı"/>

                                <TextBlock Text="Kategori:" Foreground="#AAA" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                <ComboBox x:Name="CategoryFilterComboBox" Width="130" Height="28" Background="#262630" Foreground="White"
                                          SelectionChanged="CategoryFilterComboBox_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            </StackPanel>

                            <!-- Search -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="13" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="SearchBox" Width="170" Height="28" Background="#262630" Foreground="White" BorderBrush="#444"
                                         Padding="6,2" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Items ListView -->
                    <ListView x:Name="ItemsListView" Grid.Row="1" Background="#191920" BorderBrush="#2D2D38" BorderThickness="1"
                              Foreground="#E0E0E0" SelectionMode="Single" AllowDrop="True"
                              MouseDoubleClick="ItemsListView_MouseDoubleClick"
                              PreviewMouseLeftButtonDown="ItemsListView_PreviewMouseLeftButtonDown"
                              MouseMove="ItemsListView_MouseMove"
                              DragEnter="ItemsListView_DragEnter"
                              Drop="ItemsListView_Drop">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Favori" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsFavoriteText}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Sıra" DisplayMemberBinding="{Binding Position}" Width="45"/>
                                <GridViewColumn Header="İsim" DisplayMemberBinding="{Binding Name}" Width="160"/>
                                <GridViewColumn Header="Tür" DisplayMemberBinding="{Binding Type}" Width="70"/>
                                <GridViewColumn Header="Hedef" DisplayMemberBinding="{Binding Target}" Width="330"/>
                                <GridViewColumn Header="Kategori" DisplayMemberBinding="{Binding CategoryName}" Width="130"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- TAB 2: CATEGORIES MANAGEMENT -->
            <TabItem Header="🏷️ Kategori Yönetimi">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Categories List -->
                    <Border Grid.Column="0" Background="#191920" CornerRadius="8" BorderBrush="#2D2D38" BorderThickness="1" Margin="0,0,12,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Mevcut Kategoriler" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                            <ListView x:Name="CategoriesListView" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                      Foreground="#E0E0E0" SelectionMode="Single" SelectionChanged="CategoriesListView_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="40"/>
                                        <GridViewColumn Header="Kategori Adı" DisplayMemberBinding="{Binding Name}" Width="170"/>
                                        <GridViewColumn Header="Renk Kodu" DisplayMemberBinding="{Binding Color}" Width="90"/>
                                        <GridViewColumn Header="Sıra" DisplayMemberBinding="{Binding Position}" Width="50"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Category Operations Panel -->
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <!-- Edit Selected Category Card -->
                        <Border Background="#1E1E26" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#2D2D38" BorderThickness="1">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="✏️ Seçili Kategoriyi Düzenle" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                                <TextBlock Text="Kategori Adı:" FontSize="12" Foreground="#AAA" Margin="0,0,0,4"/>
                                <TextBox x:Name="EditCategoryNameBox" Height="30" Background="#262632" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Renk (Hex):" FontSize="12" Foreground="#AAA" Margin="0,0,0,4"/>
                                <TextBox x:Name="EditCategoryColorBox" Height="30" Background="#262632" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                                <Button Content="💾 Kategori Adını Güncelle" Background="#27AE60" FontWeight="Bold" Height="34" Click="UpdateCategory_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Add New Category Card -->
                        <Border Background="#1E1E26" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#2D2D38" BorderThickness="1">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="➕ Yeni Kategori Ekle" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                                <TextBlock Text="Yeni Kategori Adı:" FontSize="12" Foreground="#AAA" Margin="0,0,0,4"/>
                                <TextBox x:Name="NewCategoryNameBox" Height="30" Background="#262632" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Renk (Hex, örn: #3498db):" FontSize="12" Foreground="#AAA" Margin="0,0,0,4"/>
                                <TextBox x:Name="NewCategoryColorBox" Text="#3498db" Height="30" Background="#262632" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                                <Button Content="➕ Yeni Kategori Oluştur" Background="#2980B9" FontWeight="Bold" Height="34" Click="AddCategory_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Delete Category Card -->
                        <Border Background="#1E1E26" CornerRadius="8" Padding="14" BorderBrush="#2D2D38" BorderThickness="1">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="🗑️ Kategori Sil" FontSize="14" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,0,0,6"/>
                                <TextBlock Text="Kategori silindiğinde içerisindeki öğeler kaybolmaz, otomatik olarak 'Hepsi'ne aktarılır." FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Content="🗑️ Seçili Kategoriyi Sil" Background="#C0392B" FontWeight="Bold" Height="34" Click="DeleteCategory_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: SMART PC SCANNER -->
            <TabItem Header="🔍 Akıllı Bilgisayar Taraması">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Info Box -->
                    <Border Grid.Row="0" Background="#1D2230" BorderBrush="#2C3E50" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="💡 Akıllı Bilgisayar Taraması &amp; Kategori Ayrıştırması" FontWeight="Bold" Foreground="#588CEC" FontSize="13"/>
                            <TextBlock Text="Bilgisayarınızdaki Başlat Menüsü, Masaüstü Kısayolları, Yüklü Programlar (Registry) ile Steam &amp; Epic oyunlarını tarar ve otomatik olarak 'Oyunlar', 'İnternet &amp; İletişim', 'Geliştirme &amp; İş' ve 'Sistem &amp; Araçlar' kategorilerine dağıtır. Ana menünüz ('Hepsi') taranan programlarla kirlenmez, sadece bizzat eklediğiniz kişisel favorileriniz kalır." 
                                       Foreground="#BBBBCC" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Scan Actions Bar -->
                    <Border Grid.Row="1" Background="#1E1E24" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🚀 Tüm Bilgisayarı Tara" Background="#27AE60" FontWeight="Bold" Margin="0,0,8,0" Click="RunFullScan_Click"/>
                                <Button Content="📥 Bulunanları Menüye Aktar" Background="#2980B9" FontWeight="Bold" Margin="0,0,8,0" Click="ImportScanned_Click"/>
                                <Button Content="Tümünü Seç" Margin="0,0,4,0" Click="SelectAllScanned_Click"/>
                                <Button Content="Seçimi Kaldır" Margin="0,0,12,0" Click="DeselectAllScanned_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="ScanStatusText" Grid.Column="1" Text="Tarama bekleniyor..." Foreground="#888899" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- Scanned Apps List -->
                    <ListView x:Name="ScannedAppsListView" Grid.Row="2" Background="#191920" BorderBrush="#2D2D38" BorderThickness="1"
                              Foreground="#E0E0E0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Seç" Width="45">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Uygulama Adı" DisplayMemberBinding="{Binding Name}" Width="190"/>
                                <GridViewColumn Header="Atanan Kategori" DisplayMemberBinding="{Binding CategoryName}" Width="150"/>
                                <GridViewColumn Header="Kaynak" DisplayMemberBinding="{Binding Source}" Width="100"/>
                                <GridViewColumn Header="Hedef Konum / Komut" DisplayMemberBinding="{Binding Target}" Width="360"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- TAB 4: THEMES -->
            <TabItem Header="🎨 Temalar &amp; Renkler">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E24" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎨 Aktif Renk Teması:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="ThemeComboBox" Width="180" Height="30" Background="#262632" Foreground="White" BorderBrush="#444"
                                      SelectionChanged="ThemeComboBox_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#191920" CornerRadius="8" BorderBrush="#2D2D38" BorderThickness="1" Padding="20">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Seçilen Tema Önizlemesi" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="#22222A" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Arka Plan" Foreground="#888" FontSize="11"/>
                                        <Rectangle x:Name="PreviewBgColor" Height="28" RadiusX="4" RadiusY="4" Margin="0,6,0,0" Fill="#121216"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#22222A" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Vurgu &amp; Noktalar" Foreground="#888" FontSize="11"/>
                                        <Rectangle x:Name="PreviewAccentColor" Height="28" RadiusX="4" RadiusY="4" Margin="0,6,0,0" Fill="#588CEC"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#22222A" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="İkon Zemin" Foreground="#888" FontSize="11"/>
                                        <Rectangle x:Name="PreviewIconBgColor" Height="28" RadiusX="4" RadiusY="4" Margin="0,6,0,0" Fill="#1E1E24"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="#22222A" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Merkez Buton" Foreground="#888" FontSize="11"/>
                                        <Rectangle x:Name="PreviewCenterColor" Height="28" RadiusX="4" RadiusY="4" Margin="0,6,0,0" Fill="#2C2C34"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="Seçilen tema, radyal menünüz açıldığında anında dinamik olarak uygulanır. Radial Launcher koyu ve şeffaf katmanlarla göz yormayan modern cam efekti (acrylic/blur) kullanır."
                                       Foreground="#888899" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: GENERAL SETTINGS & SHORTCUTS -->
            <TabItem Header="⚙️ Genel &amp; Kısayollar">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Windows Startup & Backup -->
                    <Border Grid.Row="0" Background="#1E1E24" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Sistem Başlangıcı ve Yedekleme" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                            
                            <CheckBox x:Name="StartupCheckBox" Content="Windows açılışında Radial Launcher'ı otomatik başlat" Foreground="#CCCCCC"
                                      Margin="0,0,0,14" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="📥 JSON Yedek Dışa Aktar" Background="#27AE60" FontWeight="SemiBold" Margin="0,0,10,0" Click="ExportButton_Click"/>
                                <Button Content="📤 JSON Yedek İçe Aktar" Background="#2980B9" FontWeight="SemiBold" Click="ImportButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Controls Guide Card -->
                    <Border Grid.Row="1" Background="#1E1E24" CornerRadius="8" Padding="16" BorderBrush="#2D2D38" BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Kullanım &amp; Kısayol İpuçları" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                            <TextBlock Text="• Radyal Menüyü Açma: Fare Orta Tıkı (Tekerlek Tıklaması) ile fare imlecinizin tam olduğu yerde açılır." Foreground="#BBB" Margin="0,2,0,2"/>
                            <TextBlock Text="• Sayfa &amp; Kategori Değiştirme: Menü açıkken fare tekerleğini yukarı/aşağı kaydırabilir veya alt kısımdaki kategori noktalarına tıklayabilirsiniz." Foreground="#BBB" Margin="0,2,0,2"/>
                            <TextBlock Text="• Hızlı Arama: Menü açıkken hiçbir yere tıklamadan doğrudan klavyeden aradığınız uygulamanın adını yazmaya başlayın." Foreground="#BBB" Margin="0,2,0,2"/>
                            <TextBlock Text="• Açık Pencereler: '🪟 Açık Pencereler' sekmesinden çalışan uygulamalar arasında tek tıkla geçiş yapabilir, orta tık ile kapatabilirsiniz." Foreground="#BBB" Margin="0,2,0,2"/>
                            <TextBlock Text="• Hızlı Kapatma: ESC tuşuna basabilir, menü dışına tıklayabilir ya da merkezdeki '✕' düğmesine basabilirsiniz." Foreground="#BBB" Margin="0,2,0,2"/>
                            <TextBlock Text="• Ayarları Açma: Merkez butona Sağ Tıklayarak veya Sistem Tepsisindeki simgeye sağ tıklayıp 'Settings' diyerek açabilirsiniz." Foreground="#BBB" Margin="0,2,0,2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Bottom Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Radial Launcher — Tam Ekran ve Oyun Uyumlu Radyal Kısayol Yöneticisi" Foreground="#666677" VerticalAlignment="Center" FontSize="11.5"/>
            <Button Content="Kapat" Grid.Column="1" Width="90" Height="32" Background="#3E3E4C" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
