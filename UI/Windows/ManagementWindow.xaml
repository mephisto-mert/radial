<Window x:Class="RadialLauncher.UI.Windows.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RadialLauncher.UI.Controls"
        Title="Radial Launcher — Settings &amp; Management" Height="720" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#0C0C12" Foreground="#ECECF1"
        WindowStyle="SingleBorderWindow"
        AllowDrop="True" PreviewDragOver="ManagementWindow_DragOver" Drop="ManagementWindow_Drop">
    <Window.Resources>
        <!-- Modern Sidebar TabControl Style -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#0C0C12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Sidebar -->
                            <Border Grid.Column="0" Background="#11111A" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" Padding="14,18">
                                <DockPanel>
                                    <!-- App Header -->
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚙️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Radial Launcher" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="#22588CEC" CornerRadius="4" Padding="6,2" Margin="0,8,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="v1.0.0 FINAL RELEASE" FontSize="10" FontWeight="Bold" Foreground="#588CEC"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Vertical Tab Navigation Items -->
                                    <StackPanel IsItemsHost="True" VerticalAlignment="Top"/>
                                </DockPanel>
                            </Border>

                            <!-- Right Content Area -->
                            <Grid Grid.Column="1" Background="#0A0A10">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar TabItem Style -->
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#22588CEC"/>
                                <Setter Property="Foreground" Value="#588CEC"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#14141E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#14141E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#588CEC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#588CEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ECECF1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Modern Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#588CEC"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Tab Control with Modern Left Sidebar -->
        <TabControl x:Name="MainTabs" Grid.Row="0">
            <!-- TAB 1: APPLICATIONS & SHORTCUTS -->
            <TabItem x:Name="TabItem_Apps" Header="📋  Applications &amp; Shortcuts">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Header & Actions -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="TxtTab1Title" Text="Application &amp; Shortcut Management" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="TxtTab1Sub" Text="Manage all apps, games, websites, and folders listed in the radial menu." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnScanPC" Content="🔍 Scan PC" Padding="14,7" Margin="0,0,8,0" Background="#20202C" Foreground="White" BorderBrush="#35FFFFFF" Click="ScanButton_Click"/>
                            <Button x:Name="BtnAddItem" Content="➕ Add New Item" Padding="16,7" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="AddItemButton_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Filter Bar -->
                    <Border Grid.Row="1" Background="#14141E" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCategoryLabel" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CategoryFilterCombo" Width="170" SelectionChanged="CategoryFilterCombo_SelectionChanged"/>
                                <Button x:Name="BtnRenameCategory" Content="✏️" ToolTip="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RenameCategoryToolTip}" Width="30" Height="28" Padding="2" Margin="6,0,0,0" Background="#22222E" Foreground="#588CEC" BorderBrush="#35FFFFFF" Click="BtnRenameCategory_Click"/>
                                <TextBlock x:Name="TxtSearchLabel" Text="Search:" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <TextBox x:Name="SearchBox" Width="200" Padding="8,5" Background="#1C1C26" Foreground="White" BorderBrush="#35FFFFFF" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Items DataGrid -->
                    <DataGrid x:Name="ItemsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="#121218" Foreground="White" RowBackground="#13131C" AlternatingRowBackground="#171724"
                              BorderBrush="#25FFFFFF" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1AFFFFFF"
                              HeadersVisibility="Column" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColStar" Header="⭐" Binding="{Binding IsFavoriteText}" Width="32"/>
                            <DataGridTextColumn x:Name="ColOrder" Header="Order" Binding="{Binding Position}" Width="36"/>
                            <DataGridTemplateColumn x:Name="ColIcon" Header="Icon" Width="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColName" Header="Name" Binding="{Binding Name}" Width="135"/>
                            <DataGridTextColumn x:Name="ColType" Header="Type" Binding="{Binding Type}" Width="55"/>
                            <DataGridTextColumn x:Name="ColCategory" Header="Category" Binding="{Binding CategoryName}" Width="90"/>
                            <DataGridTextColumn x:Name="ColLaunchCount" Header="Launches" Binding="{Binding LaunchCount}" Width="65"/>
                            <DataGridTextColumn x:Name="ColTarget" Header="Target" Binding="{Binding Target}" Width="*" MinWidth="120"/>
                            <DataGridTemplateColumn x:Name="ColActions" Header="Actions" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="⭐" Padding="4,1" Margin="1,0" Background="#282835" Foreground="Gold" ToolTip="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActionFavoriteToolTip}" Click="ToggleFavorite_Click"/>
                                            <Button Content="✏️" Padding="4,1" Margin="1,0" Background="#282835" Foreground="White" ToolTip="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActionEditToolTip}" Click="EditItem_Click"/>
                                            <Button Content="🗑️" Padding="4,1" Margin="1,0" Background="#3D1A1A" Foreground="#FF6B6B" ToolTip="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActionDeleteToolTip}" Click="DeleteItem_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: THEMES & VISUAL CUSTOMIZATION -->
            <TabItem x:Name="TabItem_Themes" Header="🎨  Themes &amp; Appearance">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtTab2Title" Text="Themes &amp; Visual Customization" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtTab2Sub" Text="Select from 8 curated themes, customize radial opacity and density." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Theme Selector & Live Radial Preview -->
                        <Border Grid.Column="0" Background="#14141E" CornerRadius="10" Padding="14" Margin="0,0,16,0" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtThemesHeader" Text="Curated Themes (8 Themes)" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <ListBox x:Name="ThemesListBox" Height="170" Background="#161622" Foreground="White" BorderBrush="#35FFFFFF" SelectionChanged="ThemesListBox_SelectionChanged"/>

                                <TextBlock x:Name="TxtPreviewHeader" Text="Live Radial Preview" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,14,0,8"/>
                                <Border Background="#0C0C10" CornerRadius="10" Padding="8" BorderBrush="#25FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                                    <controls:RadialPreviewControl x:Name="LivePreviewControl"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right: Visual Tuning & Details -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,0,0,0">
                                <!-- Radial Opacity Card -->
                                <Border Background="#14141E" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="TxtOpacityTitle" Text="Radial Menu Opacity" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                            <TextBlock x:Name="OpacityValueText" Text="%90" FontWeight="Bold" Foreground="#588CEC" FontSize="14" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtOpacitySub" Text="Adjust background transparency level of the circular overlay." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                        <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="90" SmallChange="1" LargeChange="5"
                                                TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                                                ValueChanged="OpacitySlider_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Density Card -->
                                <Border Background="#14141E" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtDensityTitle" Text="Ring Density Mode" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtDensitySub" Text="Number of items displayed per circular ring page." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="DensityCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="DensityCombo_SelectionChanged">
                                            <ComboBoxItem x:Name="DensityItemExpanded" Content="Expanded (15 Items)"/>
                                            <ComboBoxItem x:Name="DensityItemCompact" Content="Compact (18 Items)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Accessibility & Performance Card -->
                                <Border Background="#14141E" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtAccessTitle" Text="Accessibility &amp; Performance" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtAccessSub" Text="Reduce motion and simplify animations for low-spec systems." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ReduceMotionCheck" Content="Reduce Motion / Simplified Animations" Foreground="White" Click="ReduceMotion_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Palette Information Card -->
                                <Border Background="#14141E" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtPaletteTitle" Text="Active Theme Color Palette" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                                        <WrapPanel x:Name="PalettePreviewPanel">
                                            <Border Background="#1C1C26" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" BorderBrush="#35FFFFFF" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle x:Name="SwatchAccent1" Width="18" Height="18" RadiusX="4" RadiusY="4" Margin="0,0,8,0" Fill="#588CEC"/>
                                                    <TextBlock x:Name="TxtAccent1Label" Text="Primary Accent" FontSize="11" VerticalAlignment="Center" Foreground="#AAA"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#1C1C26" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" BorderBrush="#35FFFFFF" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle x:Name="SwatchAccent2" Width="18" Height="18" RadiusX="4" RadiusY="4" Margin="0,0,8,0" Fill="#8C5AF5"/>
                                                    <TextBlock x:Name="TxtAccent2Label" Text="Secondary Accent" FontSize="11" VerticalAlignment="Center" Foreground="#AAA"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#1C1C26" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" BorderBrush="#35FFFFFF" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle x:Name="SwatchBackground" Width="18" Height="18" RadiusX="4" RadiusY="4" Margin="0,0,8,0" Fill="#121216"/>
                                                    <TextBlock x:Name="TxtBgLabel" Text="Background" FontSize="11" VerticalAlignment="Center" Foreground="#AAA"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#1C1C26" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" BorderBrush="#35FFFFFF" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle x:Name="SwatchCard" Width="18" Height="18" RadiusX="4" RadiusY="4" Margin="0,0,8,0" Fill="#26262E"/>
                                                    <TextBlock x:Name="TxtCardLabel" Text="Icon Bubble" FontSize="11" VerticalAlignment="Center" Foreground="#AAA"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: GENERAL SETTINGS & SHORTCUTS -->
            <TabItem x:Name="TabItem_Shortcuts" Header="⚙️  Shortcuts &amp; Startup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtTab3Title" Text="Trigger Shortcut &amp; Startup" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTab3Sub" Text="Set the mouse button or keyboard shortcut to open the radial menu." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

                        <!-- Shortcut Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtShortcutCardTitle" Text="Menu Activation Shortcut" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtShortcutCardSub" Text="Select a mouse button or keyboard hotkey to summon Radial Launcher." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ComboBox x:Name="ShortcutCombo" Width="300" SelectionChanged="ShortcutCombo_SelectionChanged" />
                                    <Button x:Name="BtnAssignShortcut" Content="🎯 Assign Custom Shortcut" Margin="10,0,0,0" Padding="14,6" Background="#282835" Foreground="White" BorderBrush="#35FFFFFF" Click="AssignCustomShortcut_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ActiveShortcutLabel" Text="Active Shortcut: MiddleClick" FontSize="12" Foreground="#588CEC" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Windows Startup Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtStartupCardTitle" Text="Windows Startup" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <CheckBox x:Name="RunOnStartupCheck" Content="Automatically start Radial Launcher in tray on Windows startup" Foreground="White" Margin="0,4,0,0" Click="RunOnStartupCheck_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Menu Behavior Info Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtBehaviorTitle" Text="🎯 Menu Behavior &amp; Navigation Guidelines" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtBehaviorBody" Text="• Auto-Close: Menu closes automatically when cursor moves 330px away.&#x0a;• Global Navigation: Drag with middle-mouse or use scroll wheel to switch pages/categories.&#x0a;• Quick Actions: Hovering items reveals instant actions at the center." FontSize="12" Foreground="#94A3B8" LineHeight="20" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: BACKUP & DATA MANAGEMENT -->
            <TabItem x:Name="TabItem_Backups" Header="💾  Backup &amp; Data">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtTab4Title" Text="Backup &amp; Data Management" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTab4Sub" Text="Safely backup and restore your shortcuts, stats, and theme settings." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

                        <!-- Local Backup Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtLocalBackupTitle" Text="💾 Local Disk Backup &amp; Restore" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtLocalBackupSub" Text="Automatically or manually backup shortcuts, categories, and settings to local storage. Last 10 backups are preserved." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="BtnLocalBackupNow" Content="💾 Create Local Backup" Padding="16,8" Margin="0,0,10,0" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="CreateLocalBackup_Click"/>
                                    <Button x:Name="BtnRestoreBackup" Content="📂 Restore from Backup" Padding="16,8" Margin="0,0,10,0" Background="#282835" Foreground="White" BorderThickness="1" BorderBrush="#35FFFFFF" Click="RestoreLocalBackup_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="BackupStatusLabel" Text="Backup location: %LOCALAPPDATA%\RadialLauncher\Backups" FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- JSON Export/Import Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtJsonBackupTitle" Text="📤 JSON Export / Import" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtJsonBackupSub" Text="Export or import your complete configuration and shortcuts as a JSON file." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnExportJson" Content="📤 Export (JSON)" Padding="14,7" Margin="0,0,10,0" Background="#22222E" Foreground="#DDD" BorderThickness="1" BorderBrush="#35FFFFFF" Click="ExportButton_Click"/>
                                    <Button x:Name="BtnImportJson" Content="📥 Import (JSON)" Padding="14,7" Background="#22222E" Foreground="#DDD" BorderThickness="1" BorderBrush="#35FFFFFF" Click="ImportButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: UPDATES & DIAGNOSTICS -->
            <TabItem x:Name="TabItem_System" Header="ℹ️  System &amp; Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtTab5Title" Text="Updates &amp; Diagnostics" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTab5Sub" Text="System diagnostic logs, error logs, and application updates." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

                        <!-- Language Selection Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtLanguageTitle" Text="🌐 Display Language" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtLanguageSub" Text="Select language for application UI and radial menu (Default: English). Sorted alphabetically." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12"/>
                                <ComboBox x:Name="LanguageCombo" Width="320" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- SteamGridDB Game Covers Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtSteamGridTitle" Text="🎮 SteamGridDB Game Covers" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtSteamGridSub" Text="Enter your SteamGridDB API key to automatically fetch 600x900 vertical poster cover art for Steam and Epic games." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnSaveSteamGridKey" Content="💾 Save Key" DockPanel.Dock="Right" Padding="14,6" Margin="10,0,0,0" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveSteamGridKey_Click"/>
                                    <TextBox x:Name="SteamGridKeyBox" Height="32" Background="#1C1C26" Foreground="White" BorderBrush="#35FFFFFF" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="SteamGridKeyStatus" Text="" FontSize="11" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>

                        <!-- Updates Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtUpdatesTitle" Text="🚀 Application Updates" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock x:Name="CurrentVersionText" Text="Installed Version: v1.0.0 (Final Release)" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                <CheckBox x:Name="AutoCheckUpdatesCheck" Content="Automatically check for updates on startup" Foreground="White" Margin="0,0,0,12" Click="AutoCheckUpdatesCheck_Click"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="CheckUpdatesNowBtn" Content="🔄 Check for Updates Now" Padding="16,8" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="CheckUpdatesNowBtn_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="UpdateCheckStatusLabel" Text="" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtDiagTitle" Text="📊 System Diagnostics &amp; Logs" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtDiagSub" Text="Application logs and system diagnostic summary." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpenLogs" Content="📁 Open Logs Folder" Padding="14,8" Margin="0,0,10,0" Background="#282835" Foreground="White" BorderThickness="1" BorderBrush="#35FFFFFF" Click="OpenLogsFolderBtn_Click"/>
                                    <Button x:Name="BtnCopyDiag" Content="📋 Copy Diagnostics" Padding="14,8" Background="#282835" Foreground="White" BorderThickness="1" BorderBrush="#35FFFFFF" Click="CopyDiagnosticsBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Factory Reset Card -->
                        <Border Background="#1A1212" CornerRadius="10" Padding="18" BorderBrush="#40FF6B6B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtResetTitle" Text="⚠️ Reset to Factory Defaults" FontSize="14" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtResetSub" Text="Restores all theme, shortcut, and visual settings to defaults. (User database is preserved)" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button x:Name="BtnResetSettings" Content="Reset to Factory Defaults" Padding="16,8" Background="#3D1A1A" Foreground="#FF6B6B" FontWeight="Bold" BorderThickness="1" BorderBrush="#66FF6B6B" HorizontalAlignment="Left" Click="ResetSettingsBtn_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="1" Background="#0C0C10" Foreground="#94A3B8" Padding="12,4">
            <TextBlock x:Name="StatusText" Text="Ready." FontSize="11"/>
        </StatusBar>
    </Grid>
</Window>
