<Window x:Class="RadialLauncher.UI.Windows.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RadialLauncher.UI.Controls"
        Title="Radial Launcher — Yönetim &amp; Ayarlar" Height="720" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#0C0C12" Foreground="#ECECF1"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <!-- Modern Sidebar TabControl Style -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#0C0C12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Sidebar -->
                            <Border Grid.Column="0" Background="#11111A" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" Padding="14,18">
                                <DockPanel>
                                    <!-- App Header -->
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚙️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Radial Launcher" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="#22588CEC" CornerRadius="4" Padding="6,2" Margin="0,8,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="v1.0.0 FINAL RELEASE" FontSize="10" FontWeight="Bold" Foreground="#588CEC"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Vertical Tab Navigation Items -->
                                    <StackPanel IsItemsHost="True" VerticalAlignment="Top"/>
                                </DockPanel>
                            </Border>

                            <!-- Right Content Area -->
                            <Grid Grid.Column="1" Background="#0A0A10">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar TabItem Style -->
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#588CEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="Foreground" Value="#A5B4FC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#13131C"/>
            <Setter Property="Foreground" Value="#ECECF1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="Padding" Value="0,3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222232"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#263A5E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ListBox Style -->
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#14141E"/>
            <Setter Property="Foreground" Value="#ECECF1"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#588CEC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Tab Control with Modern Left Sidebar -->
        <TabControl x:Name="MainTabs" Grid.Row="0">
            <!-- TAB 1: UYGULAMALAR & ÖĞELER -->
            <TabItem Header="📋  Uygulamalar &amp; Kısayollar">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Header & Actions -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Uygulama &amp; Kısayol Yönetimi" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Radyal menüde listelenen tüm program, web sitesi ve klasörleri yönetin." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔍 Bilgisayarı Tara" Padding="14,7" Margin="0,0,8,0" Background="#20202C" Foreground="White" BorderBrush="#35FFFFFF" Click="ScanButton_Click"/>
                            <Button Content="➕ Yeni Öğe Ekle" Padding="16,7" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="AddItemButton_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Filter Bar -->
                    <Border Grid.Row="1" Background="#14141E" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kategori:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CategoryFilterCombo" Width="180" SelectionChanged="CategoryFilterCombo_SelectionChanged" Background="#1C1C26" Foreground="White"/>
                                <TextBlock Text="Ara:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <TextBox x:Name="SearchBox" Width="220" Padding="8,5" Background="#1C1C26" Foreground="White" BorderBrush="#35FFFFFF" TextChanged="SearchBox_TextChanged"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Items DataGrid -->
                    <DataGrid x:Name="ItemsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="#121218" Foreground="White" RowBackground="#13131C" AlternatingRowBackground="#171724"
                              BorderBrush="#25FFFFFF" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1AFFFFFF"
                              HeadersVisibility="Column" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="⭐" Binding="{Binding IsFavoriteText}" Width="32"/>
                            <DataGridTextColumn Header="Sıra" Binding="{Binding Position}" Width="36"/>
                            <DataGridTemplateColumn Header="İkon" Width="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="İsim" Binding="{Binding Name}" Width="135"/>
                            <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="55"/>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="90"/>
                            <DataGridTextColumn Header="Çalıştırma" Binding="{Binding LaunchCount}" Width="65"/>
                            <DataGridTextColumn Header="Hedef" Binding="{Binding Target}" Width="*" MinWidth="120"/>
                            <DataGridTemplateColumn Header="İşlemler" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="⭐" Padding="4,1" Margin="1,0" Background="#282835" Foreground="Gold" ToolTip="Favori Yap" Click="ToggleFavorite_Click"/>
                                            <Button Content="✏️" Padding="4,1" Margin="1,0" Background="#282835" Foreground="White" ToolTip="Düzenle" Click="EditItem_Click"/>
                                            <Button Content="🗑️" Padding="4,1" Margin="1,0" Background="#3D1A1A" Foreground="#FF6B6B" ToolTip="Sil" Click="DeleteItem_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: TEMALAR & GÖRSEL DİZAYN SİSTEMİ -->
            <TabItem Header="🎨  Temalar &amp; Görsellik">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Görsel Temalar &amp; Şeffaflık" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="8 seçkin renk paletinden birini seçin, radyal şeffaflığı ve yoğunluğu ayarlayın." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Theme Selector & Live Radial Preview -->
                        <Border Grid.Column="0" Background="#14141E" CornerRadius="10" Padding="14" Margin="0,0,16,0" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Hazır Temalar (8 Seçkin Tema)" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <ListBox x:Name="ThemesListBox" Height="170" Background="#161622" Foreground="White" BorderBrush="#35FFFFFF" SelectionChanged="ThemesListBox_SelectionChanged"/>

                                <TextBlock Text="Canlı Dairesel Önizleme" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,14,0,8"/>
                                <Border Background="#0C0C10" CornerRadius="10" Padding="8" BorderBrush="#25FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                                    <controls:RadialPreviewControl x:Name="LivePreviewControl"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right: Visual Tuning & Details -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,0,0,0">
                                <!-- Radial Opacity Card -->
                                <Border Background="#14141E" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="Radial Şeffaflığı (Opacity)" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                            <TextBlock x:Name="OpacityValueText" Text="%90" FontWeight="Bold" Foreground="#588CEC" FontSize="14" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="Dairesel menünün arkaplan şeffaflık derecesini ayarlar." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                        <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="90" SmallChange="1" LargeChange="5"
                                                TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                                                ValueChanged="OpacitySlider_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Density Card -->
                                <Border Background="#14141E" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Halka Yoğunluğu (Density)" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
                                        <TextBlock Text="Tek bir halka sayfasında kaç öğe yerleştirileceğini belirler." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="DensityCombo" Width="260" HorizontalAlignment="Left" Background="#1C1C26" Foreground="White" SelectionChanged="DensityCombo_SelectionChanged">
                                            <ComboBoxItem Content="Geniş (15 Öğeli)"/>
                                            <ComboBoxItem Content="Kompakt (18 Öğeli)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Accessibility & Performance Card -->
                                <Border Background="#14141E" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Erişilebilirlik &amp; Performans" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
                                        <TextBlock Text="Düşük donanımlarda veya sade animasyon tercihinde hareketi azaltın." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ReduceMotionCheck" Content="Hareketi Azalt / Animasyonları Sadeleştir (Reduce Motion)" Foreground="White" Click="ReduceMotion_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Palette Information Card -->
                                <Border Background="#14141E" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Seçili Tema Renk Paleti" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                                        <WrapPanel x:Name="PalettePreviewPanel">
                                            <Border Background="#1C1C26" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" BorderBrush="#35FFFFFF" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle x:Name="SwatchAccent1" Width="18" Height="18" RadiusX="4" RadiusY="4" Margin="0,0,8,0" Fill="#588CEC"/>
                                                    <TextBlock Text="Birincil Vurgu" FontSize="11" VerticalAlignment="Center" Foreground="#AAA"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#1C1C26" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" BorderBrush="#35FFFFFF" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle x:Name="SwatchAccent2" Width="18" Height="18" RadiusX="4" RadiusY="4" Margin="0,0,8,0" Fill="#8C5AF5"/>
                                                    <TextBlock Text="İkincil Vurgu" FontSize="11" VerticalAlignment="Center" Foreground="#AAA"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#1C1C26" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" BorderBrush="#35FFFFFF" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle x:Name="SwatchBackground" Width="18" Height="18" RadiusX="4" RadiusY="4" Margin="0,0,8,0" Fill="#121216"/>
                                                    <TextBlock Text="Arkaplan" FontSize="11" VerticalAlignment="Center" Foreground="#AAA"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#1C1C26" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" BorderBrush="#35FFFFFF" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle x:Name="SwatchCard" Width="18" Height="18" RadiusX="4" RadiusY="4" Margin="0,0,8,0" Fill="#26262E"/>
                                                    <TextBlock Text="İkon Baloncuğu" FontSize="11" VerticalAlignment="Center" Foreground="#AAA"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: GENEL AYARLAR & KISAYOLLAR -->
            <TabItem Header="⚙️  Kısayol &amp; Başlangıç">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Tetikleme Kısayolu &amp; Başlangıç" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Menüyü açmak için kullanacağınız fare ve klavye kısayollarını belirleyin." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

                        <!-- Shortcut Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Menüyü Tetikleme Kısayolu" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock Text="Radial Launcher'ı ekranda açmak için farenizden veya klavyenizden bir kısayol seçin." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ComboBox x:Name="ShortcutCombo" Width="300" Background="#1C1C26" Foreground="White" SelectionChanged="ShortcutCombo_SelectionChanged">
                                        <ComboBoxItem Content="Orta Tuş (Fare Tekerleği)"/>
                                        <ComboBoxItem Content="Fare 4 (Geri Tuşu - XButton1)"/>
                                        <ComboBoxItem Content="Fare 5 (İleri Tuşu - XButton2)"/>
                                        <ComboBoxItem Content="Ctrl + Sağ Tık"/>
                                        <ComboBoxItem Content="Shift + Sağ Tık"/>
                                        <ComboBoxItem Content="Alt + Sağ Tık"/>
                                        <ComboBoxItem Content="Ctrl + Fare 4"/>
                                        <ComboBoxItem Content="Alt + Boşluk (Alt+Space)"/>
                                        <ComboBoxItem Content="Ctrl + Boşluk (Ctrl+Space)"/>
                                        <ComboBoxItem Content="F4 Tuşu"/>
                                        <ComboBoxItem Content="~ (Tilde Tuşu)"/>
                                    </ComboBox>
                                    <Button Content="🎯 Yeni Kısayol Ata" Margin="10,0,0,0" Padding="14,6" Background="#282835" Foreground="White" BorderBrush="#35FFFFFF" Click="AssignCustomShortcut_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ActiveShortcutLabel" Text="Aktif Kısayol: MiddleClick" FontSize="12" Foreground="#588CEC" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Windows Startup Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Windows Başlangıcı" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <CheckBox x:Name="RunOnStartupCheck" Content="Windows açıldığında Radial Launcher'ı otomatik başlat" Foreground="White" Margin="0,4,0,0" Click="RunOnStartupCheck_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Menu Behavior Info Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🎯 Menü Davranışı &amp; Gezinme Kuralları" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="• Otomatik Kapanma: Fare radyal menü alanından 330px uzaklaştığında menü otomatik kapanır.&#x0a;• Global Gezinme: Farenin orta tuşuyla basıp sağa/sola sürükleyerek veya fare tekerleğiyle sayfalar ve kategoriler arası geçebilirsiniz.&#x0a;• Hızlı Eylemler: Öğelerin üzerine fare ile gelindiğinde hızlı aksiyon kartı merkezde görüntülenir." FontSize="12" Foreground="#94A3B8" LineHeight="20" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: YEDEKLEME & VERİ YÖNETİMİ -->
            <TabItem Header="💾  Yedekleme &amp; Veri">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Yedekleme &amp; Veri Yönetimi" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Kısayollarınızı, istatistiklerinizi ve tema ayarlarınızı güvenle yedekleyin." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

                        <!-- Local Backup Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💾 Yerel Disk Yedekleme &amp; Geri Yükleme" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock Text="Tüm kısayollarınızı, kategorilerinizi ve istatistiklerinizi yerel diske otomatik veya manuel yedekleyin. Son 10 yedek güvenle korunur." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="💾 Şimdi Yerel Yedekle" Padding="16,8" Margin="0,0,10,0" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="CreateLocalBackup_Click"/>
                                    <Button Content="📂 Yerel Yedekten Geri Yükle" Padding="16,8" Margin="0,0,10,0" Background="#282835" Foreground="White" BorderThickness="1" BorderBrush="#35FFFFFF" Click="RestoreLocalBackup_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="BackupStatusLabel" Text="Yedekleme konumu: %LOCALAPPDATA%\RadialLauncher\Backups\" FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- JSON Export/Import Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📤 JSON Dışa / İçe Aktar" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock Text="Ayarlarınızı ve kısayollarınızı JSON dosyası olarak bilgisayarınıza kaydedin veya farklı bir cihazdan içe aktarın." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📤 Dışa Aktar (JSON)" Padding="14,7" Margin="0,0,10,0" Background="#22222E" Foreground="#DDD" BorderThickness="1" BorderBrush="#35FFFFFF" Click="ExportButton_Click"/>
                                    <Button Content="📥 İçe Aktar (JSON)" Padding="14,7" Background="#22222E" Foreground="#DDD" BorderThickness="1" BorderBrush="#35FFFFFF" Click="ImportButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: GÜNCELLEMELER & TANILAMA & SİSTEM -->
            <TabItem Header="ℹ️  Güncelleme &amp; Tanılama">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Güncellemeler &amp; Tanılama" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Sistem tanılama bilgileri, hata kayıtları ve yazılım güncellemeleri." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

                        <!-- Language Selection Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🌐 Dil Seçimi / Display Language" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock Text="Uygulama arayüzü ve radyal menü için dil seçin (Varsayılan: English). Alfabetik olarak sıralanmıştır." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12"/>
                                <ComboBox x:Name="LanguageCombo" Width="320" HorizontalAlignment="Left" Background="#1C1C26" Foreground="White" SelectionChanged="LanguageCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Updates Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🚀 Yazılım Güncellemeleri" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock x:Name="CurrentVersionText" Text="Yüklü Sürüm: v1.0.0 (Final Release)" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                <CheckBox x:Name="AutoCheckUpdatesCheck" Content="Açılışta güncellemeleri otomatik kontrol et" Foreground="White" Margin="0,0,0,12" Click="AutoCheckUpdatesCheck_Click"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="CheckUpdatesNowBtn" Content="🔄 Güncellemeleri Şimdi Kontrol Et" Padding="16,8" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="CheckUpdatesNowBtn_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="UpdateCheckStatusLabel" Text="" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics Card -->
                        <Border Background="#14141E" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📊 Tanılama &amp; Sistem Kayıtları" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock Text="Uygulama log dosyaları ve sistem tanılama bilgileri." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📁 Log Klasörünü Aç" Padding="14,8" Margin="0,0,10,0" Background="#282835" Foreground="White" BorderThickness="1" BorderBrush="#35FFFFFF" Click="OpenLogsFolderBtn_Click"/>
                                    <Button Content="📋 Tanılamayı Kopyala" Padding="14,8" Background="#282835" Foreground="White" BorderThickness="1" BorderBrush="#35FFFFFF" Click="CopyDiagnosticsBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Factory Reset Card -->
                        <Border Background="#1A1212" CornerRadius="10" Padding="18" BorderBrush="#40FF6B6B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚠️ Fabrika Ayarlarına Sıfırla" FontSize="14" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,0,0,6"/>
                                <TextBlock Text="Tüm tema, kısayol ve görsel ayarları varsayılan fabrika değerlerine geri döndürür. (Kullanıcı veritabanı korunur)" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="Fabrika Ayarlarına Sıfırla" Padding="16,8" Background="#3D1A1A" Foreground="#FF6B6B" FontWeight="Bold" BorderThickness="1" BorderBrush="#66FF6B6B" HorizontalAlignment="Left" Click="ResetSettingsBtn_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="1" Background="#0C0C10" Foreground="#94A3B8" Padding="12,4">
            <TextBlock x:Name="StatusText" Text="Hazır." FontSize="11"/>
        </StatusBar>
    </Grid>
</Window>
