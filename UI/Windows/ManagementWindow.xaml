<Window x:Class="RadialLauncher.UI.Windows.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RadialLauncher.UI.Controls"
        Title="Radial Launcher — Yönetim &amp; Ayarlar" Height="680" Width="960"
        WindowStartupLocation="CenterScreen" Background="#0F0F14" Foreground="#ECECF1"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#588CEC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙️" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Radial Launcher" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="PRO ARCHITECTURE v2.0" FontSize="11" FontWeight="Bold" Foreground="#588CEC" Margin="10,0,0,0" VerticalAlignment="Center" Background="#22588CEC" Padding="6,2"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔍 Bilgisayarı Tara" Padding="14,6" Margin="4,0" Background="#22222E" Foreground="White" BorderBrush="#35FFFFFF" Click="ScanButton_Click"/>
                <Button Content="💾 Yedekle / Dışa Aktar" Padding="14,6" Margin="4,0" Background="#22222E" Foreground="White" BorderBrush="#35FFFFFF" Click="ExportButton_Click"/>
                <Button Content="📂 Yedekten Yükle" Padding="14,6" Margin="4,0" Background="#22222E" Foreground="White" BorderBrush="#35FFFFFF" Click="ImportButton_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="#14141C" BorderBrush="#22FFFFFF" BorderThickness="1">
            <!-- TAB 1: UYGULAMALAR & ÖĞELER -->
            <TabItem Header="📋 Uygulamalar &amp; Kısayollar">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Filter & Add -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Kategori:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAA"/>
                            <ComboBox x:Name="CategoryFilterCombo" Width="160" SelectionChanged="CategoryFilterCombo_SelectionChanged" Background="#1C1C24" Foreground="White"/>
                            <TextBox x:Name="SearchBox" Width="200" Margin="16,0,0,0" Padding="6,4" Background="#1C1C24" Foreground="White" BorderBrush="#33FFFFFF" TextChanged="SearchBox_TextChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="➕ Yeni Öğe Ekle" Padding="14,6" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="AddItemButton_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Items DataGrid -->
                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="#121218" Foreground="White" RowBackground="#161620" AlternatingRowBackground="#1B1B26"
                              BorderBrush="#25FFFFFF" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1FFFFFFF"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="⭐" Binding="{Binding IsFavoriteText}" Width="40"/>
                            <DataGridTextColumn Header="Sıra" Binding="{Binding Position}" Width="50"/>
                            <DataGridTemplateColumn Header="İkon" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="İsim" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="70"/>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="130"/>
                            <DataGridTextColumn Header="Hedef" Binding="{Binding Target}" Width="*"/>
                            <DataGridTemplateColumn Header="İşlemler" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="⭐" Padding="6,2" Margin="2,0" Background="#282835" Foreground="Gold" Click="ToggleFavorite_Click"/>
                                            <Button Content="✏️" Padding="6,2" Margin="2,0" Background="#282835" Foreground="White" Click="EditItem_Click"/>
                                            <Button Content="🗑️" Padding="6,2" Margin="2,0" Background="#3D1A1A" Foreground="#FF6B6B" Click="DeleteItem_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: TEMALAR & GÖRSEL DİZAYN SİSTEMİ -->
            <TabItem Header="🎨 Temalar &amp; Görsellik">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Theme Selector & Live Radial Preview -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Hazır Temalar" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ListBox x:Name="ThemesListBox" Height="160" Background="#161622" Foreground="White" BorderBrush="#33FFFFFF" SelectionChanged="ThemesListBox_SelectionChanged"/>

                        <TextBlock Text="Canlı Önizleme" FontSize="14" FontWeight="Bold" Margin="0,16,0,8"/>
                        <Border Background="#0C0C10" CornerRadius="12" Padding="10" BorderBrush="#22FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                            <controls:RadialPreviewControl x:Name="LivePreviewControl"/>
                        </Border>
                    </StackPanel>

                    <!-- Right: Custom Theme Creator & System Options -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Özel Tema Oluşturucu (Theme Engine v2)" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tema İsmi:" VerticalAlignment="Center" Foreground="#AAA"/>
                                <TextBox x:Name="CustomThemeNameBox" Grid.Column="1" Text="Özel Temam" Padding="6,4" Background="#1A1A24" Foreground="White"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vurgu Rengi (Hex):" VerticalAlignment="Center" Foreground="#AAA"/>
                                <TextBox x:Name="CustomAccentBox" Grid.Column="1" Text="#588CEC" Padding="6,4" Background="#1A1A24" Foreground="White" TextChanged="CustomColor_TextChanged"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Arkaplan Rengi (Hex):" VerticalAlignment="Center" Foreground="#AAA"/>
                                <TextBox x:Name="CustomBgBox" Grid.Column="1" Text="#121216" Padding="6,4" Background="#1A1A24" Foreground="White" TextChanged="CustomColor_TextChanged"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kart/Baloncuk (Hex):" VerticalAlignment="Center" Foreground="#AAA"/>
                                <TextBox x:Name="CustomCardBox" Grid.Column="1" Text="#26262E" Padding="6,4" Background="#1A1A24" Foreground="White" TextChanged="CustomColor_TextChanged"/>
                            </Grid>

                            <Button Content="💾 Özel Temayı Kaydet &amp; Uygula" Padding="12,8" Margin="0,10,0,16" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveCustomTheme_Click"/>

                            <Separator Background="#22FFFFFF" Margin="0,0,0,16"/>

                            <TextBlock Text="Gelişmiş Görsel Seçenekler" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <CheckBox x:Name="FollowWindowsThemeCheck" Content="Windows Temasını Otomatik Takip Et (Açık / Koyu)" Margin="0,4" Foreground="White" Click="FollowWindowsTheme_Click"/>
                            <CheckBox x:Name="ExtractAccentCheck" Content="Windows Duvar Kağıdı / DWM Vurgu Rengini Kullan" Margin="0,4" Foreground="White" Click="ExtractAccent_Click"/>
                            <CheckBox x:Name="ReduceMotionCheck" Content="Hareketi Azalt / Animasyonları Sadeleştir (Accessibility)" Margin="0,4" Foreground="White" Click="ReduceMotion_Click"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,8">
                                <TextBlock Text="Halka Yoğunluğu (Density):" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AAA"/>
                                <ComboBox x:Name="DensityCombo" Width="130" Background="#1C1C24" Foreground="White" SelectionChanged="DensityCombo_SelectionChanged">
                                    <ComboBoxItem Content="Geniş (15 Öğeli)"/>
                                    <ComboBoxItem Content="Kompakt (18 Öğeli)"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: GENEL AYARLAR & KISAYOLLAR & BULUT -->
            <TabItem Header="⚙️ Kısayol &amp; Bulut Eşitleme">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="580" HorizontalAlignment="Left">
                        <TextBlock Text="Menüyü Tetikleme Kısayolu" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ComboBox x:Name="ShortcutCombo" Width="260" HorizontalAlignment="Left" Background="#1C1C24" Foreground="White" SelectionChanged="ShortcutCombo_SelectionChanged">
                            <ComboBoxItem Content="Orta Tuş (Fare Tekerleği)"/>
                            <ComboBoxItem Content="Ctrl + Sağ Tık"/>
                            <ComboBoxItem Content="Shift + Sağ Tık"/>
                            <ComboBoxItem Content="Alt + Sağ Tık"/>
                            <ComboBoxItem Content="Alt + Boşluk (Alt+Space)"/>
                            <ComboBoxItem Content="Ctrl + Boşluk (Ctrl+Space)"/>
                            <ComboBoxItem Content="F4 Tuşu"/>
                            <ComboBoxItem Content="~ (Tilde Tuşu)"/>
                        </ComboBox>

                        <Separator Background="#22FFFFFF" Margin="0,20,0,20"/>

                        <TextBlock Text="Windows Başlangıcı" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="RunOnStartupCheck" Content="Windows açıldığında Radial Launcher'ı otomatik başlat" Foreground="White" Click="RunOnStartupCheck_Click"/>

                        <Separator Background="#22FFFFFF" Margin="0,20,0,20"/>

                        <!-- GitHub Gist Cloud Sync -->
                        <TextBlock Text="☁️ GitHub Gist Bulut Senkronizasyonu" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Ayarlarınızı ve kısayollarınızı GitHub Gist üzerinden yedekleyin veya başka bir bilgisayarla eşitleyin. Token yerel DPAPI ile şifrelenir." FontSize="12" Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="GistPatBox" Background="#1A1A24" Foreground="White" Padding="8,6" BorderBrush="#33FFFFFF"/>
                            <Button x:Name="SavePatBtn" Grid.Column="1" Content="Token Kaydet" Margin="8,0,0,0" Padding="14,6" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SavePatBtn_Click"/>
                        </Grid>

                        <TextBlock x:Name="PatStatusText" Text="Durum: Token ayarlanmamış" FontSize="11" Foreground="#F39C12" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="SyncNowBtn" Content="☁️ Şimdi Eşitle (Gist'e Yükle)" Padding="14,8" Margin="0,0,10,0" Background="#282835" Foreground="White" BorderThickness="1" BorderBrush="#35FFFFFF" Click="SyncNowBtn_Click"/>
                            <Button x:Name="SyncPullBtn" Content="📥 Gist'ten Geri Yükle" Padding="14,8" Background="#282835" Foreground="White" BorderThickness="1" BorderBrush="#35FFFFFF" Click="SyncPullBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#0C0C10" Foreground="#888" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Hazır."/>
        </StatusBar>
    </Grid>
</Window>
