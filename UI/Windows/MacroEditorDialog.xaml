<Window x:Class="RadialLauncher.UI.Windows.MacroEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Makro Adımları Düzenleyici" Height="560" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E24" Foreground="#E6E6E6">
    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="⚡ Makro Sıralı Eylem Listesi" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

        <!-- Steps ListBox -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="StepsListBox" Background="#141418" BorderBrush="#33FFFFFF" Foreground="White"
                     SelectionChanged="StepsListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#25252E" CornerRadius="6" Padding="10,8" Margin="0,2,0,2" BorderThickness="1" BorderBrush="#22FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="#3498DB" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Target}" FontSize="11" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1E1E24" CornerRadius="4" Padding="6,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding DelayMs, StringFormat='⏱️ {0} ms'}" FontSize="11" Foreground="#F39C12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Reorder / Delete Buttons -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                <Button x:Name="MoveUpBtn" Content="⬆️ Yukarı" Width="80" Height="30" Margin="0,0,0,6"
                        Background="#3A3A45" Foreground="White" BorderThickness="0" Click="MoveUpBtn_Click"/>
                <Button x:Name="MoveDownBtn" Content="⬇️ Aşağı" Width="80" Height="30" Margin="0,0,0,6"
                        Background="#3A3A45" Foreground="White" BorderThickness="0" Click="MoveDownBtn_Click"/>
                <Button x:Name="DeleteStepBtn" Content="🗑️ Sil" Width="80" Height="30"
                        Background="#C0392B" Foreground="White" BorderThickness="0" Click="DeleteStepBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- New Step Inputs -->
        <Border Grid.Row="2" Background="#24242C" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#33FFFFFF">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="➕ Yeni Adım Ekle" FontSize="13" FontWeight="Bold" Foreground="#3498DB" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <!-- Name & Type -->
                    <TextBlock Text="Adım Adı:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox x:Name="NewStepNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" Height="26" Background="#1E1E24" Foreground="White" BorderBrush="#444" Padding="4,2"/>
                    <TextBlock Text="Tür:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6"/>
                    <ComboBox x:Name="NewStepTypeComboBox" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,0,0,6" Height="26" Background="#1E1E24" Foreground="White" BorderBrush="#444" SelectionChanged="NewStepTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="EXE" IsSelected="True"/>
                        <ComboBoxItem Content="URL"/>
                        <ComboBoxItem Content="ACTION"/>
                    </ComboBox>

                    <!-- Target -->
                    <TextBlock Text="Hedef:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox x:Name="NewStepTargetTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" Height="26" Background="#1E1E24" Foreground="White" BorderBrush="#444" Padding="4,2"/>
                    <ComboBox x:Name="NewStepActionComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" Height="26" Background="#1E1E24" Foreground="White" BorderBrush="#444" Visibility="Collapsed" DisplayMemberPath="DisplayName" SelectedValuePath="ActionKey" SelectionChanged="NewStepActionComboBox_SelectionChanged"/>
                    <Button x:Name="NewStepBrowseBtn" Content="Gözat..." Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Height="26" Margin="0,0,0,6" Background="#3A3A45" Foreground="White" BorderThickness="0" Click="NewStepBrowseBtn_Click"/>

                    <!-- Args & Delay -->
                    <TextBlock Text="Argümanlar:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="NewStepArgsTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0" Height="26" Background="#1E1E24" Foreground="White" BorderBrush="#444" Padding="4,2"/>
                    <TextBlock Text="Gecikme:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="NewStepDelayTextBox" Grid.Row="2" Grid.Column="3" Height="26" Background="#1E1E24" Foreground="White" BorderBrush="#444" Padding="4,2" Text="200"/>
                    <Button x:Name="AddStepBtn" Content="Ekle" Grid.Row="2" Grid.Column="4" Height="26" Margin="6,0,0,0" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="AddStepBtn_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Save / Cancel Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveBtn" Content="Kaydet" Width="90" Height="32" Margin="0,0,10,0"
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveBtn_Click"/>
            <Button x:Name="CancelBtn" Content="İptal" Width="80" Height="32"
                    Background="#444" Foreground="#CCC" BorderThickness="0" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
