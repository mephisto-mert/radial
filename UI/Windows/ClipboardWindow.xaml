<Window x:Class="RadialLauncher.UI.Windows.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard History"
        Width="480" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E17"
        Icon="../../app.ico"
        ResizeMode="CanResizeWithGrip">
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtHeaderTitle" Text="📋 Clipboard History" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock x:Name="TxtHeaderSubtitle" Text="Double-click an item to copy it back to your active clipboard." FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- List -->
        <Border Grid.Row="1" Background="#121726" BorderBrush="#20293E" BorderThickness="1" CornerRadius="6" Padding="6">
            <ListBox x:Name="ClipList" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ClipList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#182032" CornerRadius="4" Padding="10,8" Margin="0,2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#F8FAFC" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2" x:Name="ClipStatusText" Foreground="#10B981" FontSize="11" Margin="0,8,0,8" FontWeight="SemiBold"/>

        <!-- Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="ClearBtn" Content="Clear All" Width="90" Height="32"
                    Background="#1E2638" Foreground="#EF4444" BorderBrush="#3B2632" Cursor="Hand" Click="ClearBtn_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="RemoveBtn" Content="Remove" Width="80" Height="32" Margin="0,0,8,0"
                        Background="#1E2638" Foreground="#F8FAFC" BorderBrush="#2E3A52" Cursor="Hand" Click="RemoveBtn_Click"/>
                <Button x:Name="CopyBtn" Content="Copy" Width="80" Height="32" Margin="0,0,8,0"
                        Background="#6366F1" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="CopyBtn_Click"/>
                <Button x:Name="CloseBtn" Content="Close" Width="70" Height="32"
                        Background="#1E2638" Foreground="#94A3B8" BorderBrush="#2E3A52" Cursor="Hand" Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
