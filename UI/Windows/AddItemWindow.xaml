<Window x:Class="RadialLauncher.UI.Windows.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Item" Height="420" Width="500" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#121218" Foreground="#F8FAFC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Name -->
        <TextBlock x:Name="TxtNameLabel" Text="Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,14" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,14" Height="30" Padding="8,4"/>

        <!-- Type -->
        <TextBlock x:Name="TxtTypeLabel" Text="Type:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,14" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <ComboBox x:Name="TypeComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,14" Height="30"
                  SelectionChanged="TypeComboBox_SelectionChanged">
            <ComboBoxItem Content="EXE" IsSelected="True"/>
            <ComboBoxItem Content="URL"/>
            <ComboBoxItem Content="FILE"/>
            <ComboBoxItem Content="FOLDER"/>
            <ComboBoxItem Content="SUBMENU"/>
            <ComboBoxItem Content="ACTION"/>
            <ComboBoxItem Content="MACRO"/>
        </ComboBox>

        <!-- Target -->
        <TextBlock x:Name="TxtTargetLabel" Text="Target:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,14" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="TargetTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,14" Height="30" Padding="8,4"
                 ToolTip="Executable path, website URL (e.g. youtube.com), file or folder path"/>
        <ComboBox x:Name="ActionSelectComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,14" Height="30"
                  Visibility="Collapsed" SelectionChanged="ActionSelectComboBox_SelectionChanged" DisplayMemberPath="DisplayName" SelectedValuePath="ActionKey"/>
        <Button x:Name="EditMacroBtn" Content="⚡ Edit Macro Steps..." Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="30" Margin="0,0,0,14"
                Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0" Visibility="Collapsed" Click="EditMacroBtn_Click"/>
        <Button x:Name="BrowseButton" Content="Browse..." Grid.Row="2" Grid.Column="2" Width="75" Height="30" Margin="0,0,0,14"
                Click="BrowseButton_Click"/>

        <!-- Arguments -->
        <TextBlock x:Name="TxtArgsLabel" Text="Arguments:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,14" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="ArgsTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,14" Height="30" Padding="8,4"
                 ToolTip="Optional command line arguments"/>

        <!-- Category -->
        <TextBlock x:Name="TxtCategoryLabel" Text="Category:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,14" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,14" Height="30"
                  DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>

        <!-- Favorite Checkbox -->
        <CheckBox x:Name="FavoriteCheckBox" Content="Add to Favorites (Inner Ring ⭐)" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" 
                  Margin="0,0,0,14" VerticalAlignment="Center"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="95" Height="34" Margin="0,0,10,0" 
                    Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="85" Height="34" 
                    Background="#22222E" Foreground="#AAA" BorderThickness="1" BorderBrush="#35FFFFFF" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
