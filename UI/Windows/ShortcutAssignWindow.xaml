<Window x:Class="RadialLauncher.UI.Windows.ShortcutAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Kısayol Ata — Radial Launcher" Height="360" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#14141C" Foreground="#ECECF1" WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🎯 Yeni Kısayol Tuşu veya Fare Butonu Ata" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
            <TextBlock Text="Kullanmak istediğiniz klavye tuş kombinasyonuna basın veya aşağıdaki fare butonlarından birine tıklayın." FontSize="12" Foreground="#8E8EA0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Current Detected Display -->
        <Border Grid.Row="1" Background="#0C0C10" CornerRadius="10" BorderBrush="#588CEC" BorderThickness="2" Padding="16" Margin="0,0,0,16" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Algılanan Kısayol:" FontSize="11" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="ShortcutDisplayText" Text="Tuşa veya Fare Butonuna Basın..." FontSize="20" FontWeight="Bold" Foreground="#588CEC" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="ShortcutRawText" Text="Internal: None" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Quick Mouse Button Selectors -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Hızlı Fare Butonu Seçimi:" FontSize="12" FontWeight="SemiBold" Foreground="#AAA" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button Content="🖱️ Orta Tuş" Padding="10,6" Margin="0,0,6,6" Background="#22222E" Foreground="White" BorderBrush="#35FFFFFF" Click="QuickMouse_Click" Tag="MiddleClick"/>
                <Button Content="🖱️ Fare 4 (XButton1)" Padding="10,6" Margin="0,0,6,6" Background="#22222E" Foreground="White" BorderBrush="#35FFFFFF" Click="QuickMouse_Click" Tag="XButton1"/>
                <Button Content="🖱️ Fare 5 (XButton2)" Padding="10,6" Margin="0,0,6,6" Background="#22222E" Foreground="White" BorderBrush="#35FFFFFF" Click="QuickMouse_Click" Tag="XButton2"/>
                <Button Content="🖱️ Ctrl + Fare 4" Padding="10,6" Margin="0,0,6,6" Background="#22222E" Foreground="White" BorderBrush="#35FFFFFF" Click="QuickMouse_Click" Tag="Ctrl+XButton1"/>
                <Button Content="🖱️ Alt + Sağ Tık" Padding="10,6" Margin="0,0,6,6" Background="#22222E" Foreground="White" BorderBrush="#35FFFFFF" Click="QuickMouse_Click" Tag="AltRightClick"/>
                <Button Content="🖱️ Shift + Sağ Tık" Padding="10,6" Margin="0,0,6,6" Background="#22222E" Foreground="White" BorderBrush="#35FFFFFF" Click="QuickMouse_Click" Tag="ShiftRightClick"/>
            </WrapPanel>
        </StackPanel>

        <!-- Actions -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="ValidationWarningText" Text="" Foreground="#FF6B6B" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="80" Height="34" Margin="0,0,8,0" Background="#2A2A36" Foreground="#DDD" BorderThickness="0" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="Kaydet" Width="90" Height="34" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveButton_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
