<Window x:Class="RadialLauncher.UI.Windows.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RadialLauncher.UI.Localization"
        Title="{loc:Loc EditItem_Title}" Height="460" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#121218" Foreground="#F8FAFC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Name -->
        <TextBlock x:Name="TxtNameLabel" Text="{loc:Loc Item_Name}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Height="30" Padding="8,4"/>

        <!-- Type -->
        <TextBlock x:Name="TxtTypeLabel" Text="{loc:Loc Item_Type}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <ComboBox x:Name="TypeComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Height="30"
                  SelectionChanged="TypeComboBox_SelectionChanged">
            <ComboBoxItem Content="EXE"/>
            <ComboBoxItem Content="URL"/>
            <ComboBoxItem Content="FILE"/>
            <ComboBoxItem Content="FOLDER"/>
            <ComboBoxItem Content="SUBMENU"/>
            <ComboBoxItem Content="ACTION"/>
            <ComboBoxItem Content="MACRO"/>
        </ComboBox>

        <!-- Target -->
        <TextBlock x:Name="TxtTargetLabel" Text="{loc:Loc Item_Target_Link}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="TargetTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,12" Height="30" Padding="8,4"/>
        <ComboBox x:Name="ActionSelectComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,12" Height="30"
                  Visibility="Collapsed" SelectionChanged="ActionSelectComboBox_SelectionChanged" DisplayMemberPath="DisplayName" SelectedValuePath="ActionKey"/>
        <Button x:Name="EditMacroBtn" Content="{loc:Loc Edit_Macro}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="30" Margin="0,0,0,12"
                Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0" Visibility="Collapsed" Click="EditMacroBtn_Click"/>
        <Button x:Name="BrowseTargetButton" Content="{loc:Loc Browse}" Grid.Row="2" Grid.Column="2" Width="75" Height="30" Margin="0,0,0,12"
                Click="BrowseTargetButton_Click"/>

        <!-- Arguments -->
        <TextBlock x:Name="TxtArgsLabel" Text="{loc:Loc Item_Args}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="ArgsTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Height="30" Padding="8,4"/>

        <!-- Category -->
        <TextBlock x:Name="TxtCategoryLabel" Text="{loc:Loc Item_Category}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Height="30"
                  DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>

        <!-- Custom Icon -->
        <TextBlock x:Name="TxtIconLabel" Text="{loc:Loc Item_Icon}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="IconTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,8,12" Height="30" Padding="8,4"
                 ToolTip="{loc:Loc Item_Icon_Tooltip}"/>
        <Button x:Name="BrowseIconButton" Content="{loc:Loc Browse_Icon}" Grid.Row="5" Grid.Column="2" Width="75" Height="30" Margin="0,0,0,12"
                Click="BrowseIconButton_Click"/>

        <!-- Favorite Checkbox -->
        <CheckBox x:Name="FavoriteCheckBox" Content="{loc:Loc Item_Favorite_Edit}" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" 
                  Margin="0,0,0,12" VerticalAlignment="Center"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="{loc:Loc Save}" Width="95" Height="34" Margin="0,0,10,0" 
                    Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="{loc:Loc Cancel}" Width="85" Height="34" 
                    Background="#22222E" Foreground="#AAA" BorderThickness="1" BorderBrush="#35FFFFFF" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
