<Window x:Class="RadialLauncher.UI.Windows.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Öğeyi Düzenle" Height="460" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#121218" Foreground="#F8FAFC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Name -->
        <TextBlock Text="İsim:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Height="30" Padding="8,4"/>

        <!-- Type -->
        <TextBlock Text="Tür:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <ComboBox x:Name="TypeComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Height="30"
                  SelectionChanged="TypeComboBox_SelectionChanged">
            <ComboBoxItem Content="EXE"/>
            <ComboBoxItem Content="URL"/>
            <ComboBoxItem Content="FILE"/>
            <ComboBoxItem Content="FOLDER"/>
            <ComboBoxItem Content="SUBMENU"/>
            <ComboBoxItem Content="ACTION"/>
            <ComboBoxItem Content="MACRO"/>
        </ComboBox>

        <!-- Target -->
        <TextBlock Text="Hedef / Link:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="TargetTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,12" Height="30" Padding="8,4"/>
        <ComboBox x:Name="ActionSelectComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,12" Height="30"
                  Visibility="Collapsed" SelectionChanged="ActionSelectComboBox_SelectionChanged" DisplayMemberPath="DisplayName" SelectedValuePath="ActionKey"/>
        <Button x:Name="EditMacroBtn" Content="⚡ Makro Adımlarını Düzenle..." Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="30" Margin="0,0,0,12"
                Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0" Visibility="Collapsed" Click="EditMacroBtn_Click"/>
        <Button x:Name="BrowseTargetButton" Content="Gözat..." Grid.Row="2" Grid.Column="2" Width="75" Height="30" Margin="0,0,0,12"
                Click="BrowseTargetButton_Click"/>

        <!-- Arguments -->
        <TextBlock Text="Argümanlar:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="ArgsTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Height="30" Padding="8,4"/>

        <!-- Category -->
        <TextBlock Text="Kategori:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Height="30"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <!-- Custom Icon -->
        <TextBlock Text="Özel İkon:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBox x:Name="IconTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,8,12" Height="30" Padding="8,4"
                 ToolTip="İsteğe bağlı özel .ico, .exe veya .png dosya yolu"/>
        <Button x:Name="BrowseIconButton" Content="İkon Seç" Grid.Row="5" Grid.Column="2" Width="75" Height="30" Margin="0,0,0,12"
                Click="BrowseIconButton_Click"/>

        <!-- Favorite Checkbox -->
        <CheckBox x:Name="FavoriteCheckBox" Content="Favori Olarak İşaretle (⭐)" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" 
                  Margin="0,0,0,12" VerticalAlignment="Center"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Kaydet" Width="95" Height="34" Margin="0,0,10,0" 
                    Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveButton_Click"/>
            <Button Content="İptal" Width="85" Height="34" 
                    Background="#22222E" Foreground="#AAA" BorderThickness="1" BorderBrush="#35FFFFFF" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
