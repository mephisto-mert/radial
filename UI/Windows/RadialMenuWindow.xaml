<Window x:Class="RadialLauncher.UI.Windows.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Radial Launcher" Height="600" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown" TextInput="Window_TextInput" MouseWheel="Window_MouseWheel"
        automation:AutomationProperties.Name="Radial Launcher Circular Menu"
        automation:AutomationProperties.HelpText="Application and shortcut launcher">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <!-- Outer glow shadow -->
        <Ellipse x:Name="GlowEllipse" Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#558CACEC" Opacity="0.45"/>
            </Ellipse.Effect>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#00000000" Offset="0.85"/>
                    <GradientStop Color="#22558CEC" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Base circle with gradient -->
        <Ellipse x:Name="BaseCircle" Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                 StrokeThickness="1.5">
            <Ellipse.Fill>
                <SolidColorBrush x:Name="BaseFill" Color="#E8121216"/>
            </Ellipse.Fill>
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="BorderGrad1" Color="#33588CEC" Offset="0"/>
                    <GradientStop x:Name="BorderGrad2" Color="#11588CEC" Offset="0.5"/>
                    <GradientStop x:Name="BorderGrad3" Color="#33588CEC" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
        </Ellipse>

        <!-- Hover Info Header in Upper Center -->
        <TextBlock x:Name="HoverInfoText" Text="{Binding HoveredItemTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-100,0,0"
                   TextAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="Black" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Contextual Quick Actions Floating Card (Dead Center inside Empty Circle) -->
        <Border x:Name="ContextActionCard" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"
                Background="#F0101016" CornerRadius="11" Padding="4,2" BorderThickness="1" BorderBrush="#45588CEC"
                Visibility="Collapsed" SnapsToDevicePixels="True" Panel.ZIndex="200">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="Black" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel x:Name="ContextActionPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Container for radial items (Center area is empty space) -->
        <Canvas x:Name="ItemsCanvas" Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center">
        </Canvas>

        <!-- Pinned Quick Actions Strip (Bottom Inner Area) -->
        <ItemsControl x:Name="QuickActionsBar" ItemsSource="{Binding QuickActions}" 
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="32" Height="32" Margin="3,0" Background="#33FFFFFF" BorderThickness="1" BorderBrush="#22FFFFFF"
                            Command="{Binding DataContext.ExecuteQuickActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Cursor="Hand" ToolTip="{Binding Name}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="{Binding IconSymbol}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Search overlay -->
        <Border x:Name="SearchBorder" Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#EE1E1E24" CornerRadius="16" Padding="12,4" Margin="0,130,0,0"
                BorderThickness="1" BorderBrush="#44588CEC">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 " FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock x:Name="SearchText" Text="{Binding SearchQuery}" FontSize="12" Foreground="White" VerticalAlignment="Center" MinWidth="70"/>
                <TextBlock Text="|" FontSize="12" Foreground="#588CEC" VerticalAlignment="Center">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Category & Page Info Pill -->
        <Border x:Name="CategoryPill" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,88,0,0"
                Background="#E015151B" CornerRadius="10" Padding="10,3" BorderThickness="1" BorderBrush="#35FFFFFF"
                SnapsToDevicePixels="True" Cursor="Hand" MouseLeftButtonUp="CategoryPill_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.65"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel x:Name="CategoryDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock x:Name="CategoryTitleText" Text="{Binding CurrentCategory.Name, FallbackValue='Categories'}" 
                           FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" 
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,1"/>
            </StackPanel>
        </Border>

        <!-- First-run Tutorial Overlay -->
        <Border x:Name="TutorialOverlay" Visibility="{Binding ShowTutorial, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#F0101014" CornerRadius="24" Margin="60" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTutorialHeader" Text="🚀 Welcome to Radial Launcher!" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtTutorialBody" Text="• Middle Click: Open / close radial menu&#x0a;• Click any icon: Launch application or shortcut&#x0a;• Mouse wheel / Drag: Navigate pages and categories&#x0a;• Type anytime: Fast search across all apps" FontSize="13" Foreground="#DDD" Margin="0,0,0,16" LineHeight="20"/>
                <Button x:Name="BtnDismissTutorial" Content="Got it! Start using" Padding="16,6" Background="#588CEC" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        HorizontalAlignment="Center" Cursor="Hand" Command="{Binding DismissTutorialCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
