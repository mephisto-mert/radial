<Window x:Class="RadialLauncher.UI.Windows.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RadialLauncher.UI.Localization"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{loc:Loc App_Name, Fallback='Radial Launcher'}" Height="680" Width="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="Manual" Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown" TextInput="Window_TextInput" MouseWheel="Window_MouseWheel"
        AllowDrop="True" PreviewDragOver="Window_DragOver" Drop="Window_Drop"
        automation:AutomationProperties.Name="{loc:Loc App_Name, Fallback='Radial Launcher Circular Menu'}"
        automation:AutomationProperties.HelpText="{loc:Loc App_Sub, Fallback='Application and shortcut launcher'}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <!-- Rovyl-style 7-stop smoothstep radial vignette scrim (no hard disk edge) -->
        <Ellipse x:Name="GlowEllipse" Width="660" Height="660" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="True">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#78040507" Offset="0.0"/>
                    <GradientStop Color="#6E040507" Offset="0.18"/>
                    <GradientStop Color="#56040507" Offset="0.36"/>
                    <GradientStop Color="#38040507" Offset="0.54"/>
                    <GradientStop Color="#1C040507" Offset="0.72"/>
                    <GradientStop Color="#08040507" Offset="0.88"/>
                    <GradientStop Color="#00040507" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Subtle orbit ring (replaces heavy opaque BaseCircle so tiles float directly over desktop) -->
        <Ellipse x:Name="BaseCircle" Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center"
                 StrokeThickness="1" StrokeDashArray="3 4" IsHitTestVisible="False">
            <Ellipse.Fill>
                <SolidColorBrush x:Name="BaseFill" Color="#00000000"/>
            </Ellipse.Fill>
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="BorderGrad1" Color="#18FFFFFF" Offset="0"/>
                    <GradientStop x:Name="BorderGrad2" Color="#08FFFFFF" Offset="0.5"/>
                    <GradientStop x:Name="BorderGrad3" Color="#18FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
        </Ellipse>

        <!-- Top Status HUD Pill (Rovyl RadialHud: Clock + Battery + Context Profile + Live Now Playing Media Controls) -->
        <Border x:Name="TopHudPill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                Background="#E808090C" CornerRadius="15" Padding="13,5" BorderThickness="1" BorderBrush="#2CFFFFFF"
                IsHitTestVisible="True" Panel.ZIndex="140">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Color="Black" Opacity="0.58"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HudClockText" Text="00:00" FontSize="11" FontWeight="SemiBold" Foreground="#EAFFFFFF" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="·" FontSize="11" Foreground="#55FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HudBatteryText" Text="⚡ 100%" FontSize="11" FontWeight="Medium" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                <TextBlock Text="·" FontSize="11" Foreground="#55FFFFFF" Margin="7,0,7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HudProfileBadgeText" Text="⚡ Akıllı" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <StackPanel x:Name="HudNowPlayingPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="1" Height="13" Background="#28FFFFFF" Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HudMediaTitleText" Text="♫ Medya" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="BtnHudPrev" Content="⏮" Width="18" Height="18" FontSize="9" Foreground="#DDFFFFFF" Background="#1EFFFFFF" BorderThickness="0" Cursor="Hand" Margin="1,0" Click="BtnHudMediaPrev_Click"/>
                    <Button x:Name="BtnHudPlayPause" Content="⏯" Width="18" Height="18" FontSize="9" Foreground="#FFFFFF" Background="#2E10B981" BorderThickness="0" Cursor="Hand" Margin="1,0" Click="BtnHudMediaPlayPause_Click"/>
                    <Button x:Name="BtnHudNext" Content="⏭" Width="18" Height="18" FontSize="9" Foreground="#DDFFFFFF" Background="#1EFFFFFF" BorderThickness="0" Cursor="Hand" Margin="1,0" Click="BtnHudMediaNext_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Animated Floating Action / Volume / Boost / Calculator Toast Badge -->
        <Border x:Name="ActionToastBadge" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"
                Background="#F20D1117" CornerRadius="12" Padding="12,4" BorderThickness="1" BorderBrush="#5538BDF8"
                Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" Panel.ZIndex="210">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.88" ScaleY="0.88"/>
                    <TranslateTransform Y="-6"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBlock x:Name="ActionToastText" Text="🔊 Ses: %75" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
        </Border>

        <!-- Hidden legacy HoverInfoText (kept for code-behind compatibility; labels now open as outer pills) -->
        <TextBlock x:Name="HoverInfoText" Text="{Binding HoveredItemTitle}" Visibility="Collapsed"/>

        <!-- Directional Aim Ray, Active Sector Arc & Radial Volume/Dwell Ring -->
        <Canvas x:Name="AimIndicatorCanvas" Width="500" Height="500"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" Panel.ZIndex="10">
            <Path x:Name="AimSectorWedge" Opacity="0" IsHitTestVisible="False"/>
            <Line x:Name="AimRayLine" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" IsHitTestVisible="False"/>
            <Path x:Name="AimHubArc" StrokeThickness="3.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" IsHitTestVisible="False"/>
            <Path x:Name="HubVolumeArc" StrokeThickness="3.4" Stroke="#10B981" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" IsHitTestVisible="False"/>
        </Canvas>

        <!-- Rovyl Central Hub (Dead Center 56x56 Circle with Vector Ring) -->
        <Border x:Name="CentralHubBorder" Width="56" Height="56" CornerRadius="28"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E8060709" BorderBrush="#4CFFFFFF" BorderThickness="1.5"
                Cursor="Hand" Panel.ZIndex="120" RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonUp="CentralHub_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect x:Name="CentralHubShadow" BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.65"/>
            </Border.Effect>
            <Grid>
                <!-- Root Rovyl-style Geometric Emblem -->
                <Canvas x:Name="CentralHubLogo" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="CentralHubPath"
                          Data="M11,2 L13.4,8.6 L20,11 L13.4,13.4 L11,20 L8.6,13.4 L2,11 L8.6,8.6 Z"
                          Stroke="#E6F4F2ED" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="#1AF4F2ED"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="9" Canvas.Top="9" Fill="#F4F2ED"/>
                </Canvas>
                <!-- Folder/Submenu Back Arrow -->
                <TextBlock x:Name="CentralHubBackIcon" Text="↩" FontSize="18" FontWeight="SemiBold"
                           Foreground="#F4F2ED" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Container for floating radial squircle tiles and dynamic outer pill labels -->
        <Canvas x:Name="ItemsCanvas" Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False" Panel.ZIndex="30">
        </Canvas>

        <!-- Contextual Quick Actions Floating Card (Appears cleanly above unified bottom HUD pill only on hover) -->
        <Border x:Name="ContextActionCard" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,66"
                Background="#F208090C" CornerRadius="12" Padding="6,3" BorderThickness="1" BorderBrush="#2EFFFFFF"
                Visibility="Collapsed" SnapsToDevicePixels="True" Panel.ZIndex="200">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Color="Black" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel x:Name="ContextActionPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Unified Rovyl Bottom Capsule HUD (Category Dots + Title + Key Chip + Page Dots + Integrated Utility Micro-Buttons) -->
        <Border x:Name="CategoryPill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                Background="#F006070A" CornerRadius="18" Padding="14,6" BorderThickness="1" BorderBrush="#2CFFFFFF"
                SnapsToDevicePixels="True" Cursor="Hand" Panel.ZIndex="90"
                MouseLeftButtonUp="CategoryPill_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="Black" Opacity="0.68"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="CategoryDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CategoryTitleText" Text="{Binding CurrentCategory.DisplayName, FallbackValue='Categories'}" 
                               FontSize="11.5" FontWeight="SemiBold" Foreground="#EAFFFFFF" 
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                    <Border x:Name="CategoryShortcutChip" Background="#22FFFFFF" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CategoryShortcutText" Text="Esc" FontSize="10" FontWeight="Medium" Foreground="#B8FFFFFF"/>
                    </Border>
                    <Border Width="1" Height="16" Background="#26FFFFFF" Margin="10,0,8,0" VerticalAlignment="Center"/>
                    <ItemsControl x:Name="QuickActionsBar" ItemsSource="{Binding QuickActions}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="24" Height="24" Margin="2,0" Background="#14FFFFFF" Foreground="#D8FFFFFF" BorderThickness="1" BorderBrush="#22FFFFFF"
                                        Command="{Binding DataContext.ExecuteQuickActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Cursor="Hand" ToolTip="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="#38FFFFFF"/>
                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#70FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{Binding IconSymbol}" FontSize="11" Foreground="#EAFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Search overlay -->
        <Border x:Name="SearchBorder" Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F50A0B0E" CornerRadius="16" Padding="14,6" Margin="0,-390,0,0"
                BorderThickness="1" BorderBrush="#40FFFFFF" Panel.ZIndex="210">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 " FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock x:Name="SearchText" Text="{Binding SearchQuery}" FontSize="12.5" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" MinWidth="80"/>
                <TextBlock Text="|" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- First-run Tutorial Overlay -->
        <Border x:Name="TutorialOverlay" Visibility="{Binding ShowTutorial, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#F50C0D10" CornerRadius="20" Margin="60" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="300">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTutorialHeader" Text="{loc:Loc TutorialHeader, Fallback='🚀 Welcome to Radial Launcher!'}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtTutorialBody" Text="{loc:Loc TutorialBody, Fallback='• Middle Click: Open / close radial menu&#x0a;• Click any icon: Launch application or shortcut&#x0a;• Mouse wheel / Drag: Navigate pages and categories&#x0a;• Type anytime: Fast search across all apps'}" FontSize="13" Foreground="#DDD" Margin="0,0,0,16" LineHeight="20"/>
                <Button x:Name="BtnDismissTutorial" Content="{loc:Loc TutorialDismiss, Fallback='Got it! Start using'}" Padding="16,6" Background="#FFFFFF" Foreground="#0A0A0B" FontWeight="Bold" BorderThickness="0"
                        HorizontalAlignment="Center" Cursor="Hand" Command="{Binding DismissTutorialCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
