<UserControl x:Class="RadialLauncher.UI.Controls.RadialPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220" Height="220">
    <Grid>
        <!-- Glow -->
        <Ellipse x:Name="Glow" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Effect>
                <DropShadowEffect x:Name="GlowEffect" BlurRadius="18" ShadowDepth="0" Color="#588CEC" Opacity="0.5"/>
            </Ellipse.Effect>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#00000000" Offset="0.8"/>
                    <GradientStop x:Name="GlowStop" Color="#33588CEC" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Base Circle -->
        <Ellipse x:Name="BaseCircle" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center"
                 StrokeThickness="1.5">
            <Ellipse.Fill>
                <SolidColorBrush x:Name="BaseFill" Color="#121216"/>
            </Ellipse.Fill>
            <Ellipse.Stroke>
                <SolidColorBrush x:Name="BaseStroke" Color="#588CEC"/>
            </Ellipse.Stroke>
        </Ellipse>

        <!-- Center Button -->
        <Ellipse x:Name="CenterBtn" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <SolidColorBrush x:Name="CenterFill" Color="#333338"/>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Preview Bubbles Canvas -->
        <Canvas x:Name="BubblesCanvas" Width="220" Height="220"/>
    </Grid>
</UserControl>
